### Google link — success, returns Google's consent URL
POST {{baseUrl}}/auth/google/link
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "redirect": "https://job-tracker-new.pages.dev/settings"
}

> {%
client.test('200, data.url on accounts.google.com', function () {
  client.assert(response.status === 200, 'expected 200');
  client.assert(
    response.body.data.url.indexOf('https://accounts.google.com/') === 0,
    'expected a Google consent URL',
  );
});
%}

