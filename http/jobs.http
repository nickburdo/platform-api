%}

### Filtering — partial search match
GET {{baseUrl}}/jobs?search=Dev

> {% client.test('200', function () { client.assert(response.status === 200, 'expected 200'); }); %}

### Meta — companies + statuses + stats, rate math consistent
GET {{baseUrl}}/jobs/meta

> {%
client.test('200, stats math', function () {
  client.assert(response.status === 200, 'expected 200');
  var s = response.body.data.stats;
  client.assert(Array.isArray(response.body.data.companies), 'expected companies array');
  client.assert(s.total > 0, 'expected non-zero total');
  client.assert(Math.abs(s.interviewRate - s.interviews / s.total) < 1e-9, 'interviewRate = interviews/total');
  client.assert(Math.abs(s.offerRate - s.offers / s.total) < 1e-9, 'offerRate = offers/total');
  client.assert(Math.abs(s.rejectionRate - s.rejections / s.total) < 1e-9, 'rejectionRate = rejections/total');
});
%}

### Create — 201, server-managed fields stamped
POST {{baseUrl}}/jobs
Content-Type: application/json

{
  "company": "HTTP Client Co",
  "position": "Manual Tester"
}

> {%
client.test('201, defaults + isDemo', function () {
  client.assert(response.status === 201, 'expected 201');
  client.assert(response.body.data.isDemo === true, 'expected isDemo true');
  client.assert(response.body.data.status === 'SAVED', 'expected default status SAVED');
  client.assert(response.body.data.currency === 'USD', 'expected default currency USD');
});
client.global.set('jobId', response.body.data.id);
%}

### Create — validation error → 400 with field details
POST {{baseUrl}}/jobs
Content-Type: application/json

{
  "position": "No company"
}

> {%
client.test('400, details.company', function () {
  client.assert(response.status === 400, 'expected 400');
  client.assert(response.body.error.message === 'Validation error', 'expected Validation error');
  client.assert(!!response.body.error.details.company, 'expected details.company');
});
%}

### Create — server-managed field in body → 400 (Decision #32)
POST {{baseUrl}}/jobs
Content-Type: application/json

{
  "company": "HTTP Client Co",
  "position": "Manual Tester",
  "isDemo": false
}

> {%
client.test('400, _errors', function () {
  client.assert(response.status === 400, 'expected 400');
  client.assert(!!response.body.error.details._errors, 'expected details._errors');
});
%}

### Details — success
GET {{baseUrl}}/jobs/{{jobId}}

> {%
client.test('200, same id', function () {
  client.assert(response.status === 200, 'expected 200');
  client.assert(response.body.data.id === client.global.get('jobId'), 'expected same id');
});
%}

### Details — invalid identifier → 404 envelope
GET {{baseUrl}}/jobs/definitely-not-an-id

> {%
client.test('404 envelope', function () {
  client.assert(response.status === 404, 'expected 404');
  client.assert(response.body.error.message === 'Resource not found', 'expected Resource not found');
});
%}

