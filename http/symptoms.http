# Symptoms — create, ignore/restore round-trip (v1-plan.md Section 9.2)
# No DELETE on Health Monitor: reseed via `npm run db:seed:health-monitor` cleans up.

### List — success
GET {{baseUrl}}/symptoms

> {%
client.test('200, data[]', function () {
  client.assert(response.status === 200, 'expected 200');
  client.assert(Array.isArray(response.body.data), 'expected data array');
});
%}

### Create — 201 with server stamps
POST {{baseUrl}}/symptoms
Content-Type: application/json

{
  "happenedAt": "2026-07-02T08:00:00.000Z",
  "type": "HEADACHE",
  "intensity": 3,
  "note": "HTTP Client verification"
}

> {%
client.test('201, stamps', function () {
  client.assert(response.status === 201, 'expected 201');
  client.assert(response.body.data.isDemo === true, 'expected isDemo true');
  client.assert(response.body.data.type === 'HEADACHE', 'expected type HEADACHE');
});
client.global.set('symptomId', response.body.data.id);
%}

### Create — intensity out of range → 400
POST {{baseUrl}}/symptoms
Content-Type: application/json

{
  "happenedAt": "2026-07-02T08:00:00.000Z",
  "type": "HEADACHE",
  "intensity": 11
}

> {% client.test('400', function () { client.assert(response.status === 400, 'expected 400'); }); %}

### Ignore
PATCH {{baseUrl}}/symptoms/{{symptomId}}
Content-Type: application/json

{
  "ignored": true,
  "reason": "Created by mistake"
}

> {%
client.test('200, ignored', function () {
  client.assert(response.status === 200, 'expected 200');
  client.assert(response.body.data.ignored === true, 'expected ignored true');
});
%}

### Restore
PATCH {{baseUrl}}/symptoms/{{symptomId}}
Content-Type: application/json

{
  "ignored": false,
  "reason": ""
}

> {%
client.test('200, restored', function () {
  client.assert(response.status === 200, 'expected 200');
  client.assert(response.body.data.ignored === false, 'expected ignored false');
});
%}

### Update — invalid identifier → 404
PATCH {{baseUrl}}/symptoms/definitely-not-an-id
Content-Type: application/json

{
  "intensity": 5
}

> {% client.test('404', function () { client.assert(response.status === 404, 'expected 404'); }); %}
