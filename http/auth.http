### Register a separate throwaway account for the delete-me flow
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "username": "del{{$random.alphanumeric(8)}}",
  "password": "http-client-pass-1"
}

> {%
client.test('201', function () { client.assert(response.status === 201, 'expected 201'); });
client.global.set('deleteToken', response.body.data.token);
%}

### DELETE /auth/me — deletes the throwaway account and all its data
DELETE {{baseUrl}}/auth/me
Authorization: Bearer {{deleteToken}}

> {% client.test('204', function () { client.assert(response.status === 204, 'expected 204'); }); %}

### GET /auth/me — token of the deleted account → 401, no fallback to guest
GET {{baseUrl}}/auth/me
Authorization: Bearer {{deleteToken}}

> {%
client.test('401, Invalid or expired token', function () {
  client.assert(response.status === 401, 'expected 401');
  client.assert(response.body.error.message === 'Invalid or expired token', 'expected Invalid or expired token');
});
%}

### GET /auth/me — {{token}} of the main account is still valid
GET {{baseUrl}}/auth/me
Authorization: Bearer {{token}}

> {% client.test('200', function () { client.assert(response.status === 200, 'expected 200'); }); %}
