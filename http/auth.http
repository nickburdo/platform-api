# Authentication — register, login, me, set-password, Google, delete-me (v4-plan.md Task 8)
#
# No credentials are needed: Register creates a throwaway account with a random
# username and stores {{token}}/{{username}} in client.global. Login reuses them.
# The other .http files (jobs, glucose, ...) use {{token}} for their writes, so
# run Register first.
#
# The delete-me flow at the end registers its own throwaway account ({{deleteToken}})
# and deletes that one, so {{token}} stays valid for the other files.
#
# Google sign-in and linking need a browser (Google's consent screen), so only
# their HTTP-level paths are covered here: the 302 to Google, the callback
# fragments (#token=, #link_ticket=) and a successful link completion are not
# asserted. To finish a link by hand: run "Google link — success", open
# data.url in a browser, copy the #link_ticket= value from the address bar
# (URL-decode it), and within 5 minutes send it with the same {{token}} as the
# body of POST /auth/google/link/complete — the same flow as the requests below.
#
### Register — password too short → 400
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "username": "short-pass-{{$random.alphanumeric(6)}}",
  "password": "short"
}

> {%
client.test('400, details.password', function () {
  client.assert(response.status === 400, 'expected 400');
  client.assert(!!response.body.error.details.password, 'expected details.password');
});
%}

### Register — invalid username → 400
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "username": "no spaces allowed",
  "password": "http-client-pass-1"
}

> {%
client.test('400, details.username', function () {
  client.assert(response.status === 400, 'expected 400');
  client.assert(!!response.body.error.details.username, 'expected details.username');
});
%}

### Register — success, issues a token
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "username": "http{{$random.alphanumeric(8)}}",
  "password": "http-client-pass-1"
}

> {%
client.test('201, token + user, no passwordHash', function () {
  client.assert(response.status === 201, 'expected 201');
  client.assert(typeof response.body.data.token === 'string', 'expected data.token string');
  client.assert(typeof response.body.data.user.username === 'string', 'expected username');
  client.assert(response.body.data.user.hasPassword === true, 'expected hasPassword true');
  client.assert(!response.body.data.user.passwordHash, 'passwordHash must never be serialized');
});
client.global.set('token', response.body.data.token);
client.global.set('username', response.body.data.user.username);
%}

### Register — the same username again → 409
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "username": "{{username}}",
  "password": "http-client-pass-1"
}

> {%
client.test('409, username taken', function () {
  client.assert(response.status === 409, 'expected 409');
  client.assert(response.body.error.message === 'Username is already taken', 'expected Username is already taken');
});
%}

### Login — wrong password → generic 401 (no user enumeration)
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "username": "{{username}}",
  "password": "definitely-the-wrong-password"
}

> {%
client.test('401, generic message', function () {
  client.assert(response.status === 401, 'expected 401');
  client.assert(response.body.error.message === 'Invalid credentials', 'expected Invalid credentials');
});
%}

### Login — unknown username → the same generic 401
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "username": "nobody-registered-this",
  "password": "whatever12345"
}

> {%
client.test('401, same message as wrong password', function () {
  client.assert(response.status === 401, 'expected 401');
  client.assert(response.body.error.message === 'Invalid credentials', 'expected Invalid credentials');
});
%}

### Login — malformed body → 400
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "username": "{{username}}"
}

> {% client.test('400', function () { client.assert(response.status === 400, 'expected 400'); }); %}

### Login — success, issues a token
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "username": "{{username}}",
  "password": "http-client-pass-1"
}

> {%
client.test('200, token + user, no passwordHash', function () {
  client.assert(response.status === 200, 'expected 200');
  client.assert(typeof response.body.data.token === 'string', 'expected data.token string');
  client.assert(response.body.data.user.username === client.global.get('username'), 'expected same username');
  client.assert(!response.body.data.user.passwordHash, 'passwordHash must never be serialized');
});
client.global.set('token', response.body.data.token);
%}

### GET /auth/me — with the token from Login above
GET {{baseUrl}}/auth/me
Authorization: Bearer {{token}}

> {%
client.test('200, matches the logged-in user', function () {
  client.assert(response.status === 200, 'expected 200');
  client.assert(response.body.data.username === client.global.get('username'), 'expected same username');
  client.assert(response.body.data.hasPassword === true, 'expected hasPassword true');
});
%}

### GET /auth/me — without a token → 401 (guest)
GET {{baseUrl}}/auth/me

> {%
client.test('401, Authentication required', function () {
  client.assert(response.status === 401, 'expected 401');
  client.assert(response.body.error.message === 'Authentication required', 'expected Authentication required');
});
%}

### GET /auth/me — malformed token → 401, never a silent guest fallback
GET {{baseUrl}}/auth/me
Authorization: Bearer not-a-jwt

> {%
client.test('401, Invalid or expired token', function () {
  client.assert(response.status === 401, 'expected 401');
  client.assert(response.body.error.message === 'Invalid or expired token', 'expected Invalid or expired token');
});
%}

