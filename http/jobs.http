###############################################################################
# Guests and owners (v4-plan.md): a guest is read-only and sees demo data only;
# a record created with {{token}} belongs to that user alone. Needs {{token}} —
# run auth.http's Register request first.
###############################################################################

### Owner create — a record owned by the registered user
POST {{baseUrl}}/jobs
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "company": "Owned HTTP Client Co",
  "position": "Manual Tester (owned)"
}

> {%
client.test('201, no isDemo/userId in the response', function () {
  client.assert(response.status === 201, 'expected 201');
  client.assert(response.body.data.isDemo === undefined, 'isDemo must not be exposed');
  client.assert(response.body.data.userId === undefined, 'userId must not be exposed');
});
client.global.set('ownJobId', response.body.data.id);
%}

### Guest cannot read the owner's record by id — 404, not 403
GET {{baseUrl}}/jobs/{{ownJobId}}

> {% client.test('404', function () { client.assert(response.status === 404, 'expected 404'); }); %}

### Guest cannot delete the owner's record — 401 (guest writes are rejected up front)
DELETE {{baseUrl}}/jobs/{{ownJobId}}

> {%
client.test('401, Authentication required', function () {
  client.assert(response.status === 401, 'expected 401');
  client.assert(response.body.error.message === 'Authentication required', 'expected Authentication required');
});
%}

