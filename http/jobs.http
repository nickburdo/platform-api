# Job Tracker — full CRUD + meta + edge cases (v1-plan.md Section 9.2)
# Run top to bottom: the Create request stores {{jobId}} for the later ones.
# Writes need {{token}} — run auth.http's Register request first (v4-plan.md).

### List — success, pagination envelope
GET {{baseUrl}}/jobs?page=1&limit=5

> {%
client.test('200, data[] + meta', function () {
  client.assert(response.status === 200, 'expected 200');
  client.assert(Array.isArray(response.body.data), 'expected data array');
  client.assert(response.body.meta.page === 1, 'expected meta.page 1');
  client.assert(response.body.meta.limit === 5, 'expected meta.limit 5');
});
%}

### List — guest sees demo rows only, without isDemo/userId
GET {{baseUrl}}/jobs?limit=100

> {%
client.test('200, no isDemo/userId on rows', function () {
  client.assert(response.status === 200, 'expected 200');
  response.body.data.forEach(function (row) {
    client.assert(row.isDemo === undefined, 'isDemo must not be exposed on ' + row.id);
    client.assert(row.userId === undefined, 'userId must not be exposed on ' + row.id);
  });
});
%}

