> {% client.test('400', function () { client.assert(response.status === 400, 'expected 400'); }); %}

### Pagination edge — far page → 200 with empty data (last/empty page)
GET {{baseUrl}}/jobs?page=999

> {%
client.test('200, empty page', function () {
  client.assert(response.status === 200, 'expected 200');
  client.assert(response.body.data.length === 0, 'expected empty data');
  client.assert(response.body.meta.total > 0, 'expected non-zero total');
});
%}

